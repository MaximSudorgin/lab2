public class Main {

    static int[] dist = new int[2];

    public static void main(String[] args) {
        Thread rabbit = new Thread(new Animal("Кролик", 0), "Кролик");
        Thread turtle = new Thread(new Animal("Черепаха", 1), "Черепаха");

        rabbit.setPriority(Thread.MIN_PRIORITY);
        turtle.setPriority(Thread.MAX_PRIORITY);

        System.out.println("Гонка началась!");
        System.out.println();

        rabbit.start();
        turtle.start();
    }
}

class Animal implements Runnable {
    String name;
    int id;

    Animal(String name, int id) {
        this.name = name;
        this.id = id;
    }

    public void run() {
        Thread me = Thread.currentThread();
        int other = 1 - id;

        for (int m = 0; m < 100; m++) {
            Main.dist[id] = m;

            if (Main.dist[id] < Main.dist[other]) {
                me.setPriority(Thread.MAX_PRIORITY);
            } else {
                me.setPriority(Thread.MIN_PRIORITY);
            }
            Thread.yield();

            long s = 0;
            for (int k = 0; k < 10000; k++) {
                s += k;
            }

            if (m % 10 == 0) {
                System.out.println(name + " - " + m + " м (приоритет " + me.getPriority() + ")");
            }
        }
        System.out.println(name + " добежал до финиша!");
    }
}
